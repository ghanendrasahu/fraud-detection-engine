# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Model
MODEL_PATH=models/fraud_model.onnx
XGBOOST_MODEL_PATH=models/fraud_model.pkl

# Logging
LOG_LEVEL=INFO

# App
APP_ENV=development

# LLM (Optional - falls back to template-based investigator)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Security -----------------------------------------------------------------
# When set (non-empty), POST /v1/* routes require header `X-API-Key: <value>`;
# 401 otherwise. Leave empty to disable (local development).
# API_KEY=change-me-in-production
# Explicit CORS allowlist (comma-separated). Never use "*".
# BACKEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501

# --- Identity risk (Predictive Cybersecurity Intelligence) ---------------------
# AUTH_MAX_SPEED=900.0
# AUTH_STEP_UP_THRESHOLD=40.0
# AUTH_BLOCK_THRESHOLD=80.0
